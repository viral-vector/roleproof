{
  "name": "@roleproof/storage",
  "version": "0.5.0",
  "private": false,
  "description": "RoleProof local SQLite storage foundation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viral-vector/roleproof.git",
    "directory": "packages/storage"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm --dir ../.. build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roleproof/shared": "workspace:*",
    "better-sqlite3": "12.4.1",
    "kysely": "0.29.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
