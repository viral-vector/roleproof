{
  "name": "@roleproof/reporters",
  "version": "0.3.0",
  "private": false,
  "description": "RoleProof analysis reporter contracts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viral-vector/roleproof.git",
    "directory": "packages/reporters"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm --dir ../.. build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roleproof/shared": "workspace:*"
  }
}
