{
  "name": "@roleproof/core",
  "version": "0.2.0",
  "private": false,
  "description": "RoleProof core analysis contracts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "data",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viral-vector/roleproof.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node ../../scripts/sync-core-data.mjs",
    "prepack": "pnpm --dir ../.. build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roleproof/shared": "workspace:*"
  }
}
