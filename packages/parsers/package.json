{
  "name": "@roleproof/parsers",
  "version": "0.5.0",
  "private": false,
  "description": "RoleProof document parser contracts",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viral-vector/roleproof.git",
    "directory": "packages/parsers"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm --dir ../.. build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roleproof/shared": "workspace:*",
    "mammoth": "1.12.0",
    "parse5": "8.0.0",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@roleproof/test-utils": "workspace:*"
  }
}
