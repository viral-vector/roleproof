{
  "name": "@roleproof/web",
  "version": "0.3.0",
  "private": false,
  "description": "Local RoleProof web server and UI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viral-vector/roleproof.git",
    "directory": "apps/web"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build --config vite.config.ts",
    "prepack": "pnpm --dir ../.. build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@roleproof/core": "workspace:*",
    "@roleproof/parsers": "workspace:*",
    "@roleproof/reporters": "workspace:*",
    "@roleproof/shared": "workspace:*",
    "fastify": "5.6.2",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@roleproof/test-utils": "workspace:*",
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "6.4.3"
  }
}
